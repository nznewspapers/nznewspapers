---
pagination:
  data: placesList
  size: 1
  alias: place
permalink: "place/{{ place.name | slugify }}/"
layout: layout.njk
eleventyExcludeFromCollections: true
eleventyComputed:
  title: "{{ place.name }}"
---

<div class="contentbox">
  <div class="place-meta-bar">
    <span class="meta-item">{{ place.district }} District</span>
    <span class="meta-sep">&mdash;</span>
    <span class="meta-item">{{ place.region }} Region</span>
    <span class="meta-sep">&mdash;</span>
    <span class="meta-item meta-count"
      >{{ place.papers.length }} Newspaper{% if place.papers.length != 1 %}s{%
      endif %}</span
    >
  </div>

  {% if place.mermaidGraphs and place.mermaidGraphs.length > 0 %}
  <section class="lineage-section">
    <h3>Publication Lineages &amp; Family Trees</h3>
    <div class="chart-legend">
      <span>📜 Digitised on Papers Past</span>
      <span>🌐 Publisher Website Available</span>
    </div>

    <div class="mermaid-tree-list">
      {% for mg in place.mermaidGraphs %}
      <div class="mermaid-card">
        <pre class="mermaid">
{{ mg.definition }}
        </pre>
      </div>
      {% endfor %}
    </div>
  </section>
  <script type="module">
    import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs";
    mermaid.initialize({
      startOnLoad: true,
      theme: "base",
      themeVariables: {
        fontFamily: '"Source Serif 4", Georgia, serif',
        fontSize: "14px",
        background: "#eeeeee",
        primaryColor: "#f7f7f7",
        primaryBorderColor: "#111111",
        primaryTextColor: "#111111",
        lineColor: "#111111",
        edgeLabelBackground: "#eeeeee",
        nodeBorder: "1.5px",
        clusterBkg: "#eeeeee",
        clusterBorder: "#111111",
      },
      flowchart: {
        useMaxWidth: true,
        htmlLabels: true,
        curve: "basis",
      },
    });
  </script>
  {% endif %}

  <section class="all-papers-section">
    <h3>Newspaper List</h3>

    {% set lineageSet = place.lineagePaperIds or [] %} {% set inLineageCount =
    lineageSet.length %} {% set standaloneCount = place.papers.length -
    inLineageCount %}

    <div class="table-filter-bar">
      <div class="filter-group">
        <button
          type="button"
          class="filter-btn active"
          data-lineage-filter="all"
        >
          All ({{ place.papers.length }})
        </button>
        {% if inLineageCount > 0 %}
        <button type="button" class="filter-btn" data-lineage-filter="lineage">
          🌳 In Lineage Charts ({{ inLineageCount }})
        </button>
        <button
          type="button"
          class="filter-btn"
          data-lineage-filter="standalone"
        >
          📄 Standalone ({{ standaloneCount }})
        </button>
        {% endif %}
      </div>

      <div class="filter-group access-filters">
        <button
          type="button"
          class="filter-btn filter-toggle"
          data-access-filter="digitised"
        >
          📜 Digitised
        </button>
        <button
          type="button"
          class="filter-btn filter-toggle"
          data-access-filter="online"
        >
          🌐 Online
        </button>
      </div>
    </div>

    <table class="papers-data-table" id="place-papers-table">
      <thead>
        <tr>
          <th>Title</th>
          <th>Years</th>
          <th>Frequency</th>
          <th>Status</th>
          <th>Digitised</th>
          <th>Online Site</th>
          <th>Lineage</th>
        </tr>
      </thead>
      <tbody>
        {% for paper in place.papers %} {% set paperIdStr = paper.id | string %}
        {% set isInLineage = false %} {% for lId in lineageSet %} {% if lId ==
        paperIdStr %}{% set isInLineage = true %}{% endif %} {% endfor %}

        <tr
          class="paper-row"
          data-lineage="{% if isInLineage %}lineage{% else %}standalone{% endif %}"
          data-digitised="{% if paper.urlDigitized %}true{% else %}false{% endif %}"
          data-online="{% if paper.urlCurrent %}true{% else %}false{% endif %}"
        >
          <td>
            <a href="/newspapers/{{ paper.id }}/"
              ><strong>{{ paper.title }}</strong></a
            >
            {% if paper.genre and paper.genre != "Newspaper" %}
            <br /><small style="color: #666">({{ paper.genre }})</small>
            {% endif %}
          </td>
          <td>
            {% if paper.finalYear == "9999" %} {{ paper.firstYear | prettyYear
            }} – Present {% else %} {{ paper.firstYear | prettyYear }} – {{
            paper.finalYear | prettyYear }} {% endif %}
          </td>
          <td>{{ paper.frequency or "—" }}</td>
          <td>
            {% if paper.finalYear == "9999" or paper.isCurrent %} Current {%
            else %} Ceased {% endif %}
          </td>
          <td>
            {% if paper.urlDigitized %}
            <a href="{{ paper.urlDigitized }}" target="_blank" rel="noopener"
              >📜 Papers Past</a
            >
            {% else %} — {% endif %}
          </td>
          <td>
            {% if paper.urlCurrent %}
            <a href="{{ paper.urlCurrent }}" target="_blank" rel="noopener"
              >🌐 Website</a
            >
            {% else %} — {% endif %}
          </td>
          <td>
            {% if isInLineage %} 🌳 Chart {% else %} 📄 Single {% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const lineageBtns = document.querySelectorAll("[data-lineage-filter]");
    const digitisedBtn = document.querySelector(
      '[data-access-filter="digitised"]'
    );
    const onlineBtn = document.querySelector('[data-access-filter="online"]');
    const rows = document.querySelectorAll("#place-papers-table .paper-row");

    let activeLineageFilter = "all";
    let requireDigitised = false;
    let requireOnline = false;

    function applyFilters() {
      rows.forEach((row) => {
        const matchLineage =
          activeLineageFilter === "all" ||
          row.getAttribute("data-lineage") === activeLineageFilter;
        const matchDigitised =
          !requireDigitised || row.getAttribute("data-digitised") === "true";
        const matchOnline =
          !requireOnline || row.getAttribute("data-online") === "true";

        if (matchLineage && matchDigitised && matchOnline) {
          row.classList.remove("hidden-row");
        } else {
          row.classList.add("hidden-row");
        }
      });
    }

    lineageBtns.forEach((btn) => {
      btn.addEventListener("click", function () {
        lineageBtns.forEach((b) => b.classList.remove("active"));
        this.classList.add("active");
        activeLineageFilter = this.getAttribute("data-lineage-filter");
        applyFilters();
      });
    });

    if (digitisedBtn) {
      digitisedBtn.addEventListener("click", function () {
        requireDigitised = !requireDigitised;
        this.classList.toggle("active", requireDigitised);
        applyFilters();
      });
    }

    if (onlineBtn) {
      onlineBtn.addEventListener("click", function () {
        requireOnline = !requireOnline;
        this.classList.toggle("active", requireOnline);
        applyFilters();
      });
    }
  });
</script>
