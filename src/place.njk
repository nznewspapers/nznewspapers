---
pagination:
  data: placesList
  size: 1
  alias: place
permalink: "place/{{ place.name | slugify }}/"
layout: layout.njk
eleventyExcludeFromCollections: true
eleventyComputed:
  title: "Newspapers published in {{ place.name }}"
---

<div class="bannerbox">
  <div class="links">
    <a href="/places/">All Places</a>
  </div>
</div>

<div class="contentbox">
  <h3>{{ place.name }}</h3>
  <p>
    {{ place.name }} is in the {{ place.district }} district, {{ place.region }}
    region.
  </p>

  <p>
    There are {{ place.papers.length }} newspapers published in {{ place.name
    }}.
  </p>

  {% if place.mermaidGraphs and place.mermaidGraphs.length > 0 %}
  <section class="lineage-section">
    <h4>Publication Lineages &amp; Family Trees</h4>
    <p>
      The following continuations and parallel editions occurred among
      newspapers in {{ place.name }}:
    </p>

    <div class="mermaid-tree-list">
      {% for mg in place.mermaidGraphs %}
      <div class="mermaid-card">
        <pre class="mermaid">
{{ mg.definition }}
        </pre>
      </div>
      {% endfor %}
    </div>
  </section>
  <script type="module">
    import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs";
    mermaid.initialize({
      startOnLoad: true,
      theme: "neutral",
      flowchart: {
        useMaxWidth: true,
        htmlLabels: true,
        curve: "basis",
      },
    });
  </script>
  {% endif %}

  <section class="all-papers-section">
    <h4>All Newspapers in {{ place.name }}</h4>
    <div class="multicolumnbox">
      {% for paper in place.papers %}
      <div class="columnitem">
        <a href="{{ paper.url }}">{{ paper.title }}</a>
        <br />
        <span class="paper-meta">
          {% if paper.finalYear == "9999" %} Published since {{ paper.firstYear
          | prettyYear }} {% else %} {{ paper.firstYear | prettyYear }} - {{
          paper.finalYear | prettyYear }} {% endif %}
        </span>
      </div>
      {% endfor %}
    </div>
  </section>
</div>
